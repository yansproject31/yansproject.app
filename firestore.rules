rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Enforce authentication globally
    function isSignedIn() {
      return request.auth != null;
    }

    // Helper: Check if authenticated user is the designated Owner
    // OWNER EMAIL CAN BE CHANGED HERE (e.g. yansart31@gmail.com)
    function isOwner() {
      return isSignedIn() && 
             request.auth.token != null && 
             'email' in request.auth.token && 
             (
               request.auth.token.email == 'yansart31@gmail.com' || 
               (exists(/databases/$(database)/documents/users/$(request.auth.token.email)) && 
                get(/databases/$(database)/documents/users/$(request.auth.token.email)).data.role == 'OWNER')
             );
    }

    // Helper: Check if user owns the specific document
    function isOwnerOf(resourceData) {
      return isSignedIn() && resourceData.ownerId == request.auth.token.email;
    }

    // Helper: Check document payload size to prevent storage/bandwidth abuse
    function isSizeAcceptable() {
      return request.size < 512 * 1024; // 512KB limit
    }

    // Helper: Prevent raw data URI injection in attachment URLs
    function isValidAttachmentUrl(data) {
      return !('attachment_url' in data) || 
             (data.attachment_url is string && !data.attachment_url.startsWith('data:'));
    }

    // =========================================================================
    // COLLECTION SECURITY RULES
    // =========================================================================

    // Users directory: Strictly authenticated read, Owner or self-update write
    match /users/{email} {
      allow read: if isSignedIn();
      allow write: if isOwner() || (isSignedIn() && request.auth.token.email == email);
    }

    // Inventory & Catalog items
    match /stock_items/{id} {
      allow read, write: if isSignedIn() && isSizeAcceptable() && isValidAttachmentUrl(request.resource.data) && (resource == null || isOwnerOf(resource.data) || isOwner()) && (request.resource == null || isOwnerOf(request.resource.data) || isOwner());
    }

    // Custom Projects
    match /projects/{id} {
      allow read, write: if isSignedIn() && isSizeAcceptable() && isValidAttachmentUrl(request.resource.data) && (resource == null || isOwnerOf(resource.data) || isOwner()) && (request.resource == null || isOwnerOf(request.resource.data) || isOwner());
    }

    // Invoices & Billing
    match /invoices/{id} {
      allow read, write: if isSignedIn() && isSizeAcceptable() && isValidAttachmentUrl(request.resource.data) && (resource == null || isOwnerOf(resource.data) || isOwner()) && (request.resource == null || isOwnerOf(request.resource.data) || isOwner());
    }

    // Orders
    match /orders/{id} {
      allow read, write: if isSignedIn() && isSizeAcceptable() && (resource == null || isOwnerOf(resource.data) || isOwner()) && (request.resource == null || isOwnerOf(request.resource.data) || isOwner());
    }

    // Financial Expenses & Cash Outflow
    match /expenses/{id} {
      allow read, write: if isSignedIn() && isSizeAcceptable() && (resource == null || isOwnerOf(resource.data) || isOwner()) && (request.resource == null || isOwnerOf(request.resource.data) || isOwner());
    }

    // Financial Inflows & Incomes
    match /inflows/{id} {
      allow read, write: if isSignedIn() && isSizeAcceptable() && (resource == null || isOwnerOf(resource.data) || isOwner()) && (request.resource == null || isOwnerOf(request.resource.data) || isOwner());
    }

    // Internal Notifications
    match /notifications/{id} {
      allow read: if isSignedIn();
      allow write: if isOwner();
    }

    // System Backups Catalog
    match /backups_catalog/{id} {
      allow read, write: if isSignedIn() && isSizeAcceptable() && (resource == null || isOwnerOf(resource.data) || isOwner()) && (request.resource == null || isOwnerOf(request.resource.data) || isOwner());
    }

    // Encrypted Cloud Backups
    match /cloud_backups/{id} {
      allow read, write: if isSignedIn() && isSizeAcceptable() && (resource == null || isOwnerOf(resource.data) || isOwner()) && (request.resource == null || isOwnerOf(request.resource.data) || isOwner());
    }

    // Fallback rule: DENY all unhandled collections
    match /{document=**} {
      allow read, write: if isOwner();
    }
  }
}
